{
  "name": "yoawase-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh -c 'while true; do wrangler dev --ip 0.0.0.0; echo \"[dev] wrangler dev が終了しました。1秒後に再起動します(止めるには Ctrl+C 連打)\"; sleep 1; done'",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "import:venues": "node scripts/import-venues.mjs",
    "import:venues:remote": "node scripts/import-venues.mjs --remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "hono": "^4.6.0",
    "ulidx": "^2.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
  }
}
